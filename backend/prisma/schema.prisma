generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Aluguer {
  IdAluguer        String           @id(map: "PK__Aluguer__E38F97F3D7C02263") @default(uuid()) @db.Uuid
  IdUtilizador     String           @db.Uuid
  DataLevantamento DateTime         @db.Date
  DataEntrega      DateTime         @db.Date
  EstadoAluguer    String           @db.VarChar(50)
  Utilizador       Utilizador       @relation(fields: [IdUtilizador], references: [IdUtilizador], onUpdate: NoAction, map: "FK__Aluguer__IdUtili__18EBB532")
  ArtigoAluguer    ArtigoAluguer[]
  Pagamento        Pagamento[]
  PedidoExtensao   PedidoExtensao[]
}

model Aluno {
  IdUtilizador     String             @id(map: "PK__Aluno__7A170D745479A7D4") @db.Uuid
  DataNascimento   DateTime?          @db.Date
  Informacao       String?            @db.Text
  Utilizador       Utilizador         @relation(fields: [IdUtilizador], references: [IdUtilizador], onUpdate: NoAction, map: "FK__Aluno__IdUtiliza__60A75C0F")
  EncarregadoAluno EncarregadoAluno[]
  Marcacao         Marcacao[]
  PedidoAula       PedidoAula[]
}

model Artigo {
  IdArtigo            String          @id(map: "PK__Artigo__A420008D2C73DFA3") @default(uuid()) @db.Uuid
  Nome                String          @db.VarChar(100)
  CustoPorDia         Decimal         @db.Decimal(18, 2)
  EstadoArtigo        Boolean         @default(true)
  DisponivelParaAluguer Boolean       @default(false)
  ImagemPath          String?         @db.VarChar(500)
  IdUtilizadorCriador String?         @db.Uuid
  Criador             Utilizador?     @relation("ArtigoCriador", fields: [IdUtilizadorCriador], references: [IdUtilizador], onDelete: NoAction, onUpdate: NoAction)
  TamanhoArtigo       TamanhoArtigo[]

  @@index([IdUtilizadorCriador])
}

model ArtigoAluguer {
  IdTamanhoArtigo String        @db.Uuid
  IdAluguer       String        @db.Uuid
  Quantidade      Int
  EstadoDevolucao String        @db.VarChar(50)
  Aluguer         Aluguer       @relation(fields: [IdAluguer], references: [IdAluguer], onUpdate: NoAction, map: "FK__ArtigoAlu__IdAlu__1CBC4616")
  TamanhoArtigo   TamanhoArtigo @relation(fields: [IdTamanhoArtigo], references: [IdTamanhoArtigo], onUpdate: NoAction, map: "FK__ArtigoAlu__IdTam__1BC821DD")

  @@id([IdTamanhoArtigo, IdAluguer], map: "PK__ArtigoAl__161BB04BBCA212EB")
}

model Aula {
  IdAula               String       @id(map: "PK__Aula__2C89573C7FD193B4") @default(uuid()) @db.Uuid
  IdProfessor          String       @db.Uuid
  IdEstudio            String       @db.Uuid
  IdEstiloDanca        String       @db.Uuid
  Data                 DateTime     @db.Date
  HoraInicio           DateTime     @db.Time(6)
  HoraFim              DateTime     @db.Time(6)
  ConfirmacaoProfessor Boolean      @default(false)
  ValidacaoDirecao     Boolean      @default(false)
  Preco                Decimal      @db.Decimal(18, 2)
  EstaAtivo            Boolean      @default(true)
  CapacidadeMaxima     Int
  TipoAula             String       @default("Regular") @db.VarChar(50)
  OrigemAula           String       @default("Direcao") @db.VarChar(50)
  EstiloDanca          EstiloDanca  @relation(fields: [IdEstiloDanca], references: [IdEstiloDanca], onUpdate: NoAction, map: "FK__Aula__IdEstiloDa__04E4BC85")
  Estudio              Estudio      @relation(fields: [IdEstudio], references: [IdEstudio], onUpdate: NoAction, map: "FK__Aula__IdEstudio__03F0984C")
  Professor            Professor    @relation(fields: [IdProfessor], references: [IdUtilizador], onUpdate: NoAction, map: "FK__Aula__IdProfesso__02FC7413")
  Marcacao             Marcacao[]
  PedidoAula           PedidoAula[]
}

model Cidade {
  IdCidade     String         @id(map: "PK__Cidade__160879A31C3006C8") @default(uuid()) @db.Uuid
  IdDistrito   String         @db.Uuid
  Nome         String         @db.VarChar(100)
  Distrito     Distrito       @relation(fields: [IdDistrito], references: [IdDistrito], onUpdate: NoAction, map: "FK__Cidade__IdDistri__52593CB8")
  CodigoPostal CodigoPostal[]

  @@unique([IdDistrito, Nome], map: "UQ_Cidade_Nome")
}

model CodigoPostal {
  CodigoPostal                                     String       @id(map: "PK__CodigoPo__B3F46974B3A53033") @db.VarChar(20)
  IdCidade                                         String       @db.Uuid
  Cidade                                           Cidade       @relation(fields: [IdCidade], references: [IdCidade], onUpdate: NoAction, map: "FK__CodigoPos__IdCid__5629CD9C")
  Utilizador_Utilizador_CodigoPostalToCodigoPostal Utilizador[] @relation("Utilizador_CodigoPostalToCodigoPostal")
}

model Disponibilidade {
  IdDisponibilidade String    @id(map: "PK__Disponib__BC5612FD31CE530E") @default(uuid()) @db.Uuid
  IdProfessor       String    @db.Uuid
  Data              DateTime  @db.Date
  HoraInicio        DateTime  @db.Time(6)
  HoraFim           DateTime  @db.Time(6)
  Professor         Professor @relation(fields: [IdProfessor], references: [IdUtilizador], onUpdate: NoAction, map: "FK__Disponibi__IdPro__7B5B524B")
}

model Distrito {
  IdDistrito String   @id(map: "PK__Distrito__DE8EED590ECF81B6") @default(uuid()) @db.Uuid
  IdPais     String   @db.Uuid
  Nome       String   @db.VarChar(100)
  Cidade     Cidade[]
  Pais       Pais     @relation(fields: [IdPais], references: [IdPais], onUpdate: NoAction, map: "FK__Distrito__IdPais__4D94879B")

  @@unique([IdPais, Nome], map: "UQ_Distrito_Nome")
}

model Encarregado {
  IdUtilizador     String             @id(map: "PK__Encarreg__7A170D7422D1B127") @db.Uuid
  Utilizador       Utilizador         @relation(fields: [IdUtilizador], references: [IdUtilizador], onUpdate: NoAction, map: "FK__Encarrega__IdUti__6383C8BA")
  EncarregadoAluno EncarregadoAluno[]
  PedidoAula       PedidoAula[]
}

model EncarregadoAluno {
  IdEncarregado   String      @db.Uuid
  IdAluno         String      @db.Uuid
  RelacaoParental String      @db.VarChar(50)
  Aluno           Aluno       @relation(fields: [IdAluno], references: [IdUtilizador], onUpdate: NoAction, map: "FK__Encarrega__IdAlu__6A30C649")
  Encarregado     Encarregado @relation(fields: [IdEncarregado], references: [IdUtilizador], onUpdate: NoAction, map: "FK__Encarrega__IdEnc__693CA210")

  @@id([IdEncarregado, IdAluno], map: "PK__Encarreg__34C9B2807548F443")
}

model EstiloDanca {
  IdEstiloDanca   String            @id(map: "PK__EstiloDa__CCE73E132A676A15") @default(uuid()) @db.Uuid
  Nome            String            @db.VarChar(100)
  EstaAtivo       Boolean           @default(true)
  Aula            Aula[]
  EstiloProfessor EstiloProfessor[]
  EstudioEstilo   EstudioEstilo[]
  PedidoAula      PedidoAula[]
}

model EstiloProfessor {
  IdProfessor   String      @db.Uuid
  IdEstiloDanca String      @db.Uuid
  EstiloDanca   EstiloDanca @relation(fields: [IdEstiloDanca], references: [IdEstiloDanca], onUpdate: NoAction, map: "FK__EstiloPro__IdEst__70DDC3D8")
  Professor     Professor   @relation(fields: [IdProfessor], references: [IdUtilizador], onUpdate: NoAction, map: "FK__EstiloPro__IdPro__6FE99F9F")

  @@id([IdProfessor, IdEstiloDanca], map: "PK__EstiloPr__B14ACDFA8F5E527C")
}

model Estudio {
  IdEstudio     String          @id(map: "PK__Estudio__0C3B43559A1E42D8") @default(uuid()) @db.Uuid
  Numero        Int
  Capacidade    Int
  EstaAtivo     Boolean         @default(true)
  Aula          Aula[]
  EstudioEstilo EstudioEstilo[]
}

model EstudioEstilo {
  IdEstudio     String      @db.Uuid
  IdEstiloDanca String      @db.Uuid
  Estudio       Estudio     @relation(fields: [IdEstudio], references: [IdEstudio], onUpdate: NoAction, map: "FK__EstudioEs__IdEst__76969D2E")
  EstiloDanca   EstiloDanca @relation(fields: [IdEstiloDanca], references: [IdEstiloDanca], onUpdate: NoAction, map: "FK__EstudioEs__IdEst__778AC167")

  @@id([IdEstudio, IdEstiloDanca], map: "PK__EstudioE__20F530B453003BA1")
}

model Evento {
  IdEvento             String             @id(map: "PK_Evento") @default(uuid()) @db.Uuid
  IdUtilizadorCriador  String             @db.Uuid
  Titulo               String             @db.VarChar(200)
  Descricao            String             @db.Text
  DataPublicacaoInicio DateTime
  DataPublicacaoFim    DateTime
  DataEvento           DateTime           @db.Date
  Local                String             @db.VarChar(200)
  TipoEvento           String             @db.VarChar(100)
  Link                 String             @db.VarChar(500)
  EstadoEvento         Boolean            @default(true)
  Criador              Utilizador         @relation("EventoCriador", fields: [IdUtilizadorCriador], references: [IdUtilizador], onUpdate: NoAction)
  EventoComentario     EventoComentario[]

  @@index([EstadoEvento, DataPublicacaoInicio, DataPublicacaoFim])
  @@index([DataEvento])
  @@index([IdUtilizadorCriador, DataPublicacaoInicio])
}

model EventoComentario {
  IdEventoComentario String    @id(map: "PK_EventoComentario") @default(uuid()) @db.Uuid
  IdEvento           String    @db.Uuid
  IdProfessor        String    @db.Uuid
  Comentario         String    @db.Text
  DataComentario     DateTime  @default(now())
  Evento             Evento    @relation(fields: [IdEvento], references: [IdEvento], onDelete: Cascade, onUpdate: NoAction)
  Professor          Professor @relation(fields: [IdProfessor], references: [IdUtilizador], onUpdate: NoAction)

  @@index([IdEvento, DataComentario])
  @@index([IdProfessor, DataComentario])
}

model Marcacao {
  IdMarcacao                    String      @id(map: "PK__Marcacao__0FFD43310A4D8F8C") @default(uuid()) @db.Uuid
  IdAluno                       String      @db.Uuid
  IdAula                        String      @db.Uuid
  EstaAtivo                     Boolean     @default(true)
  PresencaConfirmada            Boolean     @default(false)
  MotivoCancelamento            String?     @db.Text
  DataDecisaoCancelamento       DateTime?
  DataPedidoCancelamento        DateTime?
  EstadoCancelamento            String      @default("SemPedido") @db.VarChar(50)
  IdDiretorCancelamento         String?     @db.Uuid
  ObservacaoDirecaoCancelamento String?     @db.Text
  Aluno                         Aluno       @relation(fields: [IdAluno], references: [IdUtilizador], onUpdate: NoAction, map: "FK__Marcacao__IdAlun__0B91BA14")
  Aula                          Aula        @relation(fields: [IdAula], references: [IdAula], onUpdate: NoAction, map: "FK__Marcacao__IdAula__0C85DE4D")
  Utilizador                    Utilizador? @relation(fields: [IdDiretorCancelamento], references: [IdUtilizador], onUpdate: NoAction)
  Pagamento                     Pagamento[]
}

model Pagamento {
  IdPagamento     String    @id(map: "PK__Pagament__D474651EAA61CF44") @default(uuid()) @db.Uuid
  IdAluguer       String?   @db.Uuid
  IdMarcacao      String?   @db.Uuid
  DataPagamento   DateTime? @db.Date
  PrazoPagamento  DateTime  @db.Date
  Custo           Decimal   @db.Decimal(18, 2)
  EstadoPagamento String    @db.VarChar(50)
  Aluguer         Aluguer?  @relation(fields: [IdAluguer], references: [IdAluguer], onDelete: NoAction, onUpdate: NoAction, map: "FK__Pagamento__IdAlu__208CD6FA")
  Marcacao        Marcacao? @relation(fields: [IdMarcacao], references: [IdMarcacao], onDelete: NoAction, onUpdate: NoAction, map: "FK__Pagamento__IdMar__2180FB33")
}

model Pais {
  IdPais   String     @id(map: "PK__Pais__FC850A7BBDD42FB7") @default(uuid()) @db.Uuid
  Nome     String     @db.VarChar(100)
  Sigla    String     @db.VarChar(10)
  Distrito Distrito[]
}

model PedidoExtensao {
  IdPedido         String   @id(map: "PK__PedidoEx__9D335DC30447FBEE") @default(uuid()) @db.Uuid
  IdAluguer        String   @db.Uuid
  NovaDataProposta DateTime @db.Date
  EstadoAprovacao  String   @db.VarChar(50)
  ValorAdicional   Decimal  @db.Decimal(18, 2)
  DataPedido       DateTime @default(now()) @db.Date
  Aluguer          Aluguer  @relation(fields: [IdAluguer], references: [IdAluguer], onUpdate: NoAction, map: "FK__PedidoExt__IdAlu__2739D489")
}

model Professor {
  IdUtilizador       String             @id(map: "PK__Professo__7A170D74A70F451A") @db.Uuid
  Iban               String?            @db.VarChar(50)
  Aula               Aula[]
  Disponibilidade    Disponibilidade[]
  EstiloProfessor    EstiloProfessor[]
  EventoComentario   EventoComentario[]
  PedidosConfirmados PedidoAula[]       @relation("ProfessorConfirmadoPedidoAula")
  PedidosSolicitados PedidoAula[]       @relation("ProfessorSolicitadoPedidoAula")
  Utilizador         Utilizador         @relation(fields: [IdUtilizador], references: [IdUtilizador], onUpdate: NoAction, map: "FK__Professor__IdUti__66603565")
}

model TamanhoArtigo {
  IdTamanhoArtigo String          @id(map: "PK__TamanhoA__382349348AC1E89B") @default(uuid()) @db.Uuid
  IdArtigo        String          @db.Uuid
  Tamanho         String          @db.VarChar(20)
  Quantidade      Int             @default(0)
  Condicao        String          @default("Bom") @db.VarChar(50)
  ArtigoAluguer   ArtigoAluguer[]
  Artigo          Artigo          @relation(fields: [IdArtigo], references: [IdArtigo], onUpdate: NoAction, map: "FK__TamanhoAr__IdArt__151B244E")
}

model Utilizador {
  IdUtilizador                                       String       @id(map: "PK__Utilizad__7A170D742B9663F5") @default(uuid()) @db.Uuid
  CodigoPostal                                       String       @db.VarChar(20)
  Morada                                             String       @db.VarChar(255)
  Permissoes                                         Int
  NomeCompleto                                       String       @db.VarChar(200)
  NomeUtilizador                                     String       @unique(map: "UQ__Utilizad__2A35525707669BB9") @db.VarChar(100)
  Email                                              String       @unique(map: "UQ__Utilizad__A9D10534DACDCC00") @db.VarChar(150)
  PalavraPasseHash                                   String       @db.VarChar(255)
  NumeroTelemovel                                    String?      @db.VarChar(20)
  Nif                                                String?      @unique(map: "UQ__Utilizad__C7D1D6C8219C9627") @db.VarChar(20)
  EstaAtivo                                          Boolean      @default(true)
  NumeroCartaoCidadao                                String?      @db.VarChar(30)
  ValidadeCartaoCidadao                              DateTime?    @db.Date
  Aluguer                                            Aluguer[]
  Aluno                                              Aluno?
  ArtigosCriados                                     Artigo[]     @relation("ArtigoCriador")
  Encarregado                                        Encarregado?
  EventosCriados                                     Evento[]     @relation("EventoCriador")
  Marcacao                                           Marcacao[]
  PedidoAula                                         PedidoAula[]
  Professor                                          Professor?
  CodigoPostal_Utilizador_CodigoPostalToCodigoPostal CodigoPostal @relation("Utilizador_CodigoPostalToCodigoPostal", fields: [CodigoPostal], references: [CodigoPostal], onUpdate: NoAction, map: "FK__Utilizado__Codig__5DCAEF64")
}

model PedidoAula {
  IdPedidoAulaPrivada   String      @id @default(uuid()) @db.Uuid
  IdEncarregado         String      @db.Uuid
  IdAluno               String      @db.Uuid
  IdEstiloDanca         String      @db.Uuid
  IdAulaCriada          String?     @db.Uuid
  IdDiretorDecisao      String?     @db.Uuid
  DataPretendida        DateTime    @db.Date
  HoraPretendida        DateTime    @db.Time(6)
  DuracaoMinutos        Int
  CapacidadePretendida  Int         @default(1)
  Observacoes           String?     @db.Text
  EstadoPedido          String      @default("PendenteProfessor") @db.VarChar(50)
  ObservacaoDirecao     String?     @db.Text
  DataPedido            DateTime    @default(now())
  DataDecisao           DateTime?
  IdProfessorSolicitado String?     @db.Uuid
  IdProfessorConfirmado String?     @db.Uuid
  ObservacaoProfessor   String?     @db.Text
  DataRespostaProfessor DateTime?
  Aluno                 Aluno       @relation(fields: [IdAluno], references: [IdUtilizador], onUpdate: NoAction)
  Aula                  Aula?       @relation(fields: [IdAulaCriada], references: [IdAula], onUpdate: NoAction)
  Utilizador            Utilizador? @relation(fields: [IdDiretorDecisao], references: [IdUtilizador], onUpdate: NoAction)
  Encarregado           Encarregado @relation(fields: [IdEncarregado], references: [IdUtilizador], onUpdate: NoAction)
  EstiloDanca           EstiloDanca @relation(fields: [IdEstiloDanca], references: [IdEstiloDanca], onUpdate: NoAction)
  ProfessorConfirmado   Professor?  @relation("ProfessorConfirmadoPedidoAula", fields: [IdProfessorConfirmado], references: [IdUtilizador], onDelete: NoAction, onUpdate: NoAction)
  ProfessorSolicitado   Professor?  @relation("ProfessorSolicitadoPedidoAula", fields: [IdProfessorSolicitado], references: [IdUtilizador], onDelete: NoAction, onUpdate: NoAction)

  @@index([EstadoPedido, DataPedido])
  @@index([IdAluno, DataPedido])
  @@index([IdEncarregado, DataPedido])
  @@index([IdProfessorSolicitado, EstadoPedido])
  @@index([IdProfessorConfirmado, EstadoPedido])
}


